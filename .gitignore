# Dependencies & build
node_modules/
dist/

# Secrets
.env
.env.local
.env.*.local

# ── Runtime / personal agent state (never commit) ──────────────────────────
# Session pointer + transcripts + SQLite DBs are created empty on first run /
# postinstall. Schema is applied automatically; your chats stay local.
.agent/session.json
.agent/desktop-allowlist.json
.agent/settings.json
.agent/bots.json
.agent/capabilities-prefs.json
.agent/messaging.json
.agent/whatsapp-auth/
.agent/context/**
!.agent/context/.gitkeep
.agent/task/**
!.agent/task/.gitkeep
.agent/memory/**
!.agent/memory/.gitkeep
!.agent/memory/README.md
# Personal guidelines mirror (synced from local SQLite). Starter is AGENTS.md.example
.agent/AGENTS.md
.agent/.native-abi
# Per-machine skill curator / usage counters (absolute paths, session IDs)
.agent/skills/.curator_ledger.jsonl
.agent/skills/.curator_state
.agent/skills/.usage.json
.agent/skills/.usage.json.lock

# Generated / local tooling
graphify-out/
*.log
.DS_Store
sandbox-workspace/
.tmp-pty-test/
.tmp/
coverage/
working
tmp

# Python venv (Laya decision bridge)
.venv/
