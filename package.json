{
  "name": "agent-terminal",
  "version": "0.1.0",
  "description": "Terminal-first AI coding agent powered by Deep Agents + 9router",
  "type": "module",
  "bin": {
    "agent": "./dist/index.js"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "tui": "tsx src/cli/app.tsx",
    "agent": "tsx src/index.ts",
    "postinstall": "node scripts/fix-node-pty.js && node scripts/bootstrap-agent-workspace.js",
    "bootstrap": "node scripts/bootstrap-agent-workspace.js",
    "test:unit": "tsx --test src/**/*.test.ts",
    "memory:backfill-embeddings": "tsx scripts/backfill-embeddings.ts"
  },
  "engines": {
    "node": ">=22.5"
  },
  "dependencies": {
    "@langchain/core": "^1.2.9",
    "@langchain/langgraph": "^1.4.10",
    "@langchain/langgraph-checkpoint": "^1.1.5",
    "@langchain/langgraph-checkpoint-sqlite": "^1.0.4",
    "@langchain/langgraph-sdk": "^1.9.23",
    "@langchain/openai": "^1.5.12",
    "commander": "^15.0.0",
    "deepagents": "^1.13.4",
    "dotenv": "^16.6.1",
    "ink": "^7.1.1",
    "langchain": "^1.5.11",
    "langsmith": "^0.9.0",
    "node-pty": "^1.1.0",
    "react": "^19.1.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
