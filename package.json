{
  "name": "agent-terminal",
  "version": "0.1.0",
  "description": "Terminal-first AI coding agent powered by Deep Agents + 9router",
  "type": "module",
  "bin": {
    "agent": "./dist/index.js"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json && vite build && node scripts/copy-desktop-preload.js",
    "rebuild:electron": "node scripts/ensure-native-abi.js electron",
    "rebuild:node": "node scripts/ensure-native-abi.js node",
    "desktop:dev": "npm run rebuild:electron && node scripts/desktop-dev.js",
    "desktop:start": "npm run rebuild:electron && npm run build && electron dist/desktop-app/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "tui": "npm run rebuild:node && tsx src/index.ts",
    "agent": "npm run rebuild:node && tsx src/index.ts",
    "postinstall": "node scripts/fix-node-pty.js && node scripts/bootstrap-agent-workspace.js",
    "bootstrap": "node scripts/bootstrap-agent-workspace.js",
    "test:unit": "npm run rebuild:node && tsx --test src/**/*.test.ts",
    "memory:backfill-embeddings": "tsx scripts/backfill-embeddings.ts"
  },
  "engines": {
    "node": ">=22.5"
  },
  "dependencies": {
    "@langchain/core": "^1.2.9",
    "@langchain/langgraph": "^1.4.10",
    "@langchain/langgraph-checkpoint": "^1.1.5",
    "@langchain/langgraph-checkpoint-sqlite": "^1.0.4",
    "@langchain/langgraph-sdk": "^1.9.23",
    "@langchain/openai": "^1.5.12",
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "better-sqlite3": "^13.0.3",
    "commander": "^15.0.0",
    "deepagents": "^1.13.4",
    "dotenv": "^16.6.1",
    "ink": "^7.1.1",
    "langchain": "^1.5.11",
    "langsmith": "^0.9.0",
    "mammoth": "^1.12.3",
    "mermaid": "^12.0.0",
    "node-pty": "^1.1.0",
    "playwright": "^1.63.0",
    "qrcode": "^1.5.4",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "remark-gfm": "^4.0.1",
    "xlsx": "^0.18.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.15.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vite": "^8.3.0"
  }
}
