# Model Hub (OpenAI-compatible gateway — source di src/model-hub/)
# Desktop menyalakan engine hasil copy; ROUTER_* di-inject otomatis.
# Override manual hanya untuk CLI/headless.
ROUTER_BASE_URL=
ROUTER_API_KEY=

# Prefer a model with ≥128k context window (agent budgets to this)
AGENT_MODEL=

# Cheap model for Auto-review Run Mode classifier (shell/MCP/desktop).
# Falls back to AGENT_MODEL when unset.
# AGENT_CLASSIFIER_MODEL=gpt-4o-mini

# Embeddings model via Model Hub (semantic long-term memory)
# Prefer a model listed by GET $ROUTER_BASE_URL/models/embedding
EMBEDDING_MODEL=

# Speech-to-text (OpenAI-compatible /v1/audio/transcriptions via Model Hub)
# STT_MODEL=whisper-1
# STT_MAX_UPLOAD_BYTES=26214400
# STT_TIMEOUT_MS=300000

# Context budget (tokens). Must be ≤ the model's actual context limit.
# Smaller = cheaper; summarization kicks in earlier (~55% of this value).
CONTEXT_WINDOW_TOKENS=128000
# Optional ratios (0.2–0.95):
# SUMMARIZE_TRIGGER_RATIO=0.55
# KEEP_RECENT_RATIO=0.10
# Tool result trim (chars). read_file uses the tighter READ_FILE budget.
# TOOL_RESULT_MAX_CHARS=4000
# READ_FILE_MAX_CHARS=3000

# Optional: force path to rtk binary (default: `which rtk`)
# RTK_BIN=/opt/homebrew/bin/rtk
# Disable auto rtk proxy on execute: RTK_PROXY=0

# PTY defaults
PTY_TIMEOUT_MS=60000
PTY_SHELL=

# Desktop automation (macOS osascript). Chrome-first allowlist.
# Set 0 to disable desktop_automate / request_desktop_app_access.
DESKTOP_AUTOMATION=1

# Laya decision layer (ON by default). Opt out: LAYA_ENABLED=0
# Uses heuristics instantly unless you opt into a Laya backend:
#   LAYA_URL=…              HTTP sidecar (preferred)
#   LAYA_FORCE_PROCESS=1    spawn scripts/laya_bridge.py each turn (slow cold start)
LAYA_ENABLED=1
LAYA_TIMEOUT_MS=2000
# LAYA_HEURISTIC_ONLY=1
# LAYA_URL=http://127.0.0.1:8765/predict
# LAYA_FORCE_PROCESS=0
# LAYA_PYTHON=.venv/bin/python
# LAYA_MIN_CONFIDENCE=0.55

# Stream tokens to the UI (default on). Set 0 if upstream stream roles break tool calls.
# AGENT_STREAMING=1

# Optional: workspace root override (defaults to cwd)
# AGENT_WORKSPACE=

# ── CCXT MCP (crypto exchanges — see https://docs.ccxt.com) ─────────────
# Server: npx ccxt-mcp (configured in .agent/mcp.json).
# Account config (trading/funds tiers): ~/Library/Application Support/ccxt-mcp/config.json
#   Template: .agent/ccxt-mcp.config.example.json
# Or fill missing credentials via env (ccxt-mcp):
# BINANCE_APIKEY=
# BINANCE_SECRET=
# OKX_APIKEY=
# OKX_SECRET=
# OKX_PASSWORD=
# Sandbox first: set "sandbox": true and "trading": true on the account.
# Live trading requires "trading": "live" + maxOrderValue in that config file.
# Keep withdrawals off on exchange API keys; funds tier defaults off.
