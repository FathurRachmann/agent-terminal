# 9router (OpenAI-compatible gateway)
ROUTER_BASE_URL=
ROUTER_API_KEY=

# Prefer a model with ≥256k context window
AGENT_MODEL=

# Cheap model for Auto-review Run Mode classifier (shell/MCP/desktop).
# Falls back to AGENT_MODEL when unset.
# AGENT_CLASSIFIER_MODEL=gpt-4o-mini

# Embeddings model via 9router (semantic long-term memory)
# Prefer a model listed by GET $ROUTER_BASE_URL/models/embedding
EMBEDDING_MODEL=

# Context budget (tokens). Must be ≤ the model's actual context limit.
CONTEXT_WINDOW_TOKENS=256000

# PTY defaults
PTY_TIMEOUT_MS=60000
PTY_SHELL=

# Desktop automation (macOS osascript). Chrome-first allowlist.
# Set 0 to disable desktop_automate / request_desktop_app_access.
DESKTOP_AUTOMATION=1

# Laya decision layer (ON by default). Opt out: LAYA_ENABLED=0
# Uses heuristics instantly unless you opt into a Laya backend:
#   LAYA_URL=…              HTTP sidecar (preferred)
#   LAYA_FORCE_PROCESS=1    spawn scripts/laya_bridge.py each turn (slow cold start)
LAYA_ENABLED=1
LAYA_TIMEOUT_MS=2000
# LAYA_HEURISTIC_ONLY=1
# LAYA_URL=http://127.0.0.1:8765/predict
# LAYA_FORCE_PROCESS=0
# LAYA_PYTHON=.venv/bin/python
# LAYA_MIN_CONFIDENCE=0.55

# Stream tokens to the UI (default on). Set 0 if 9router stream roles break tool calls.
# AGENT_STREAMING=1

# Optional: workspace root override (defaults to cwd)
# AGENT_WORKSPACE=
